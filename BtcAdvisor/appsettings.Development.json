{
  "Logging": {
    "LogLevel": {
      "Default": "Information",
      "Microsoft.AspNetCore": "Warning"
    }
  },
  "VolumeVolatility": {
    "EnableScoreBonus": true,
    "Interval": "1d"
  },
  "RiskControls": {
    "EnableHardStopLoss": false,
    "EnableTrailingStop": true,
    "TrailingStopActivationPercent": 100.0,
    "TrailingStopPercent": 40.0,
    "BreakevenTriggerPercent": 15.0
  }
}
